#: plugin.py
msgid ""
"An update is already running.\n\n"
"Please wait until it has finished."
msgstr ""
"Ein Update läuft bereits.\n\n"
"Bitte warten Sie, bis es abgeschlossen ist."

#: plugin.py
msgid "Could not create the update lock."
msgstr "Die Update-Sperre konnte nicht erstellt werden."

#: plugin.py
msgid "Updating CrashlogViewer..."
msgstr "CrashlogViewer wird aktualisiert..."

#: plugin.py
msgid "Update canceled."
msgstr "Aktualisierung abgebrochen."

#: plugin.py
msgid "Could not start the update installer."
msgstr "Der Update-Installer konnte nicht gestartet werden."

#: plugin.py
msgid ""
"Could not start the update installer.\n\n"
"%s"
msgstr ""
"Der Update-Installer konnte nicht gestartet werden.\n\n"
"%s"

#: plugin.py
msgid ""
"The update finished, but no installer "
"status was returned.\n\n"
"Please check:\n%s"
msgstr ""
"Das Update wurde beendet, aber es wurde kein "
"Installer-Status zurückgegeben.\n\n"
"Bitte prüfen Sie:\n%s"

#: plugin.py
msgid ""
"The update could not be installed.\n\n"
"Installer return code: %s\n\n"
"See the update log:\n%s"
msgstr ""
"Das Update konnte nicht installiert werden.\n\n"
"Installer-Rückgabecode: %s\n\n"
"Siehe Update-Log:\n%s"

#: plugin.py
msgid ""
"CrashlogViewer was updated successfully "
"to version %s.\n\n"
"Do you want to restart the Enigma2 GUI now?"
msgstr ""
"CrashlogViewer wurde erfolgreich auf Version %s "
"aktualisiert.\n\n"
"Möchten Sie die Enigma2-GUI jetzt neu starten?"

#: plugin.py
msgid ""
"CrashlogViewer was updated successfully "
"to version %s.\n\n"
"Please restart the Enigma2 GUI manually "
"to activate the new version."
msgstr ""
"CrashlogViewer wurde erfolgreich auf Version %s "
"aktualisiert.\n\n"
"Bitte starten Sie die Enigma2-GUI manuell neu, "
"um die neue Version zu aktivieren."

#: plugin.py
msgid "The GUI could not be restarted automatically."
msgstr "Die GUI konnte nicht automatisch neu gestartet werden."

#: plugin.py
msgid "Could not fetch update information."
msgstr "Update-Informationen konnten nicht abgerufen werden."

#: plugin.py
msgid ""
"Could not fetch update information.\n\n"
"The CrashlogViewer will now open."
msgstr ""
"Update-Informationen konnten nicht abgerufen werden.\n\n"
"CrashlogViewer wird jetzt geöffnet."

#: plugin.py
msgid "New version {version} is available."
msgstr "Eine neue Version {version} ist verfügbar."

#: plugin.py
msgid "Changelog:"
msgstr "Änderungen:"

#: plugin.py
msgid "Do you want to install it now?"
msgstr "Möchten Sie das Update jetzt installieren?"

#: plugin.py
msgid "The remote version ({remote}) is older than the current one ({current})."
msgstr "Die entfernte Version ({remote}) ist älter als die aktuelle Version ({current})."

#: plugin.py
msgid "The filesystem is mounted read-only."
msgstr "Das Dateisystem ist schreibgeschützt eingebunden."

#: plugin.py
msgid "read-only filesystem"
msgstr "schreibgeschütztes Dateisystem"

